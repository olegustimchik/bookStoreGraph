{
  "name": "bookstoregraph",
  "version": "1.0.0",
  "description": "Basic NestJS + Fastify + Mercurius GraphQL starter for bookStoreGraph.",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "lint": "eslint '{src,apps,libs,test}/**/*.ts' --fix",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "mc": "typeorm migration:create ./src/database/migrations/${NAME}",
    "mg": "npm run typeorm -- -d src/configuration/datasource.config.ts migration:generate ./src/database/migrations/${NAME}",
    "mr": "npm run typeorm -- -d src/configuration/datasource.config.ts migration:run",
    "mre": "npm run typeorm -- -d src/configuration/datasource.config.ts migration:revert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olegustimchik/bookStoreGraph.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/olegustimchik/bookStoreGraph/issues"
  },
  "homepage": "https://github.com/olegustimchik/bookStoreGraph#readme",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/graphql": "^13.4.0",
    "@nestjs/mercurius": "^13.4.0",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@types/cookie": "^1.0.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.4",
    "graphql": "^16.14.0",
    "ioredis": "^5.10.1",
    "mercurius": "^16.9.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.29",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.20",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  }
}
